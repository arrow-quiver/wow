# Public address of the site, no trailing slash (example below). Must match the Battle.net redirect URL.
# If empty, the first address in Coolify's COOLIFY_URL is used.
BASE_URL=https://wow.cjplumbing.co.za
# Long random string. Generate one with:  openssl rand -base64 48
SESSION_SECRET=
# From https://develop.battle.net/access/clients  (redirect URL: <BASE_URL>/auth/bnet/callback)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# Set to 1 only for local testing: lets anyone sign in by typing a BattleTag.
DEV_LOGIN=0

# --- Preview deployments (Coolify, one per pull request) ---
# Set PREVIEW=1 only in Coolify's "Preview Deployments" variables, never in production.
# A preview uses its own database, signs in by BattleTag, and sends nothing to Discord, Battle.net, push or Claude.
# PREVIEW=1
# Optional: where a preview keeps its database (default: preview.db next to DB_FILE).
# PREVIEW_DB_FILE=/data/preview.db
