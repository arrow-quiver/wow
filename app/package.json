{
  "name": "guild-camp",
  "productName": "Guild Camp",
  "version": "0.13.0",
  "private": true,
  "description": "Guild Camp: your guild, your addon and your characters in one desktop app",
  "author": "Calvin",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win --publish never",
    "vendor": "node ../scripts/vendor.js",
    "test": "node --test \"test/**/*.test.{js,mjs}\""
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.2.5",
    "@fontsource/alegreya-sans": "^5.2.5",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "fengari": "^0.1.5",
    "htm": "3.1.1",
    "luaparse": "^0.3.1",
    "preact": "10.29.8"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
