# Guild Camp server settings. Copy to server/.env for local runs (npm run dev reads it),
# or set these as environment variables in Coolify / Docker.

# ---- Basics ----
# Public address of the server, no trailing slash. Must match the Battle.net redirect URL.
BASE_URL=https://wow.cjplumbing.co.za
# Port to listen on inside the container.
PORT=3000
# Long random string. Required in production. Generate one with:  openssl rand -base64 48
SESSION_SECRET=
# SQLite database file. Backups go to <its folder>/backups.
# Default: server/data/wow.db (the Docker image sets /data/wow.db).
# DB_FILE=/data/wow.db
# production | development | test. The Docker image sets production, which makes SESSION_SECRET required.
# NODE_ENV=production

# ---- Battle.net sign-in ----
# From https://develop.battle.net/access/clients  (redirect URL: <BASE_URL>/auth/bnet/callback)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# Region for Blizzard game data (eu, us, kr, tw).
BNET_REGION=eu
# Set to 1 only for local testing: lets anyone sign in by typing a BattleTag.
DEV_LOGIN=0

# ---- Releases (app and addon updates) ----
# Lets scripts/release.js and CI publish updates without an owner's device token.
# Long random string; give the same value to GUILDCAMP_PUBLISH_TOKEN on the publishing side.
PUBLISH_TOKEN=
# Where published installers and addon zips are kept. Default: <folder of DB_FILE>/updates
UPDATES_DIR=
# The addon offered until the first addon release is published.
# Default: ../addon/WowGuild next to the server (in Docker: /srv/addon/WowGuild).
BUNDLED_ADDON_DIR=

# ---- Discord app (slash commands). From https://discord.com/developers/applications ----
# Interactions Endpoint URL: <BASE_URL>/discord/interactions
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Only needed to register slash commands and Discord scheduled events.
DISCORD_BOT_TOKEN=

# ---- Coach (Claude API). Without a key the Coach still tracks play style; AI features are off. ----
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5
COACH_FAST_MODEL=claude-haiku-5-5

# ---- Time ----
# Used only when a client doesn't send its own time zone offset, in minutes (JavaScript style).
# -120 = South Africa (UTC+2).
DEFAULT_TZ_OFFSET=-120
